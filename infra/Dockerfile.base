# Trusted base for every sandbox (built by us, never by repo code). Non-root user, venv owned by that user.
ARG PY=3.12
FROM python:${PY}-slim
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* \
 && useradd -m -u 1000 pp && python -m venv /opt/venv && chown -R pp:pp /opt/venv
# apply_patch: the patch tool gpt-oss models use regardless of the prompt (root-owned, read-only to the sandbox user)
COPY --chmod=755 apply_patch.py /usr/local/bin/apply_patch
ENV PATH=/opt/venv/bin:$PATH PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
# Tools every setup needs, baked in (built by us, not by repo code): SETUP no longer waits on PyPI for them, and a
# project that pins its own versions still gets those. pip>=25.1 matches INSTALL's upgrade, so that step is a no-op.
RUN /opt/venv/bin/pip install --no-cache-dir -q "pip>=25.1" setuptools wheel pytest && chown -R pp:pp /opt/venv
# #99: PatchPilot's own pinned ruff for the `ruff format` repo check when the repo's env has none. Its own venv, root-owned
# (repo code can't swap it) and off PATH (the repo's tools and tests never see it).
RUN python -m venv /opt/pp-tools && /opt/pp-tools/bin/pip install --no-cache-dir -q ruff==0.17.3
USER pp
WORKDIR /src
