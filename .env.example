# Copy to .env (git-ignored). Never commit real values. Only the API/worker read this file; sandboxes never see it.
GITHUB_READ_TOKEN=          # fine-grained, public repos, read-only (5,000 req/h instead of 60)
SUPPLYGUARD_CMD=data/tools/supplyguard/backend/node_modules/.bin/tsx data/tools/supplyguard/backend/src/cli/index.ts
GEMINI_API_KEY=
GROQ_API_KEY=                # optional: fallback when Gemini is out of quota/overloaded
PP_LOCAL_MODEL=              # optional last fallback, e.g. ollama_chat/qwen2.5-coder:7b (needs `ollama serve`)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
FERNET_KEY=                  # generate: uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PUBLIC_URL=                  # e.g. https://<host>.<tailnet>.ts.net (OAuth callback = PUBLIC_URL/auth/github/callback)
PP_DOCKER_RUNTIME=          # runsc on the MVP VM (gVisor); empty on Docker Desktop
