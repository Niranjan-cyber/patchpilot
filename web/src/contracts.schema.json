      "ai_policy": "unknown",
      "prs_restricted": null,
      "source_evidence_ids": []
     }
    },
    "env": {
     "anyOf": [
      {
       "$ref": "#/$defs/EnvProfile"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "baseline": {
     "anyOf": [
      {
       "$ref": "#/$defs/TestRun"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "repro": {
     "anyOf": [
      {
       "$ref": "#/$defs/ReproTest"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "diagnosis": {
     "anyOf": [
      {
       "$ref": "#/$defs/Diagnosis"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "patch": {
     "anyOf": [
      {
       "$ref": "#/$defs/Patch"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "verify": {
     "anyOf": [
      {
       "$ref": "#/$defs/Verification"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "supplyguard": {
     "anyOf": [
      {
       "$ref": "#/$defs/SGReport"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "review": {
     "anyOf": [
      {
       "$ref": "#/$defs/ReviewResult"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "gates": {
     "additionalProperties": {
      "$ref": "#/$defs/CheckStatus"
     },
     "default": {},
     "title": "Gates",
     "type": "object"
    },
    "steps": {
     "additionalProperties": {
      "$ref": "#/$defs/StepState"
